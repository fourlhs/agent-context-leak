# Copy to `.env` and fill in the key. `.env` is gitignored and must stay that
# way: a key that reaches a commit on a public repo is the failure this project
# exists to measure, arriving by the shortest possible route.
#
# A real environment variable beats this file, so `ANTHROPIC_API_KEY=... uv run ...`
# and CI secrets both work without editing anything here.
ANTHROPIC_API_KEY=
